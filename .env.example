# PulseGuard 1.0.1-poc local configuration
# Copy to .env. scripts/start.ps1 creates .env automatically and replaces
# CHANGE_ME_* values with local random secrets.

# Public live signal
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
WIKIMEDIA_USER_AGENT=PulseGuard/1.0.1-poc (local portfolio reliability demo)
WIKIMEDIA_TLS_VERIFY=true
WIKIMEDIA_CA_BUNDLE=
WIKIMEDIA_WINDOW_SECONDS=30
WIKIMEDIA_STALE_AFTER_SECONDS=30

# Live signal -> local synthetic load
TRAFFIC_MODE=wikimedia
TRAFFIC_MIN_USERS=10
TRAFFIC_BASE_USERS=25
TRAFFIC_MAX_USERS=80
TRAFFIC_FALLBACK_USERS=15
TRAFFIC_PROFILE_POLL_SECONDS=5
TRAFFIC_SPAWN_RATE=10

# Public host ports
CHECKOUT_PORT=8080
PAYMENT_ROUTER_PORT=8081
LOCUST_PORT=8089
SCENARIO_PORT=8090
WIKIMEDIA_ADAPTER_PORT=8093
CORRUPTION_ADAPTER_PORT=8094
TOXIPROXY_ADMIN_PORT=8474
OPSAI_CORE_PORT=8095
OPSAI_AGENT_PORT=8096
OPSAI_AUTOMATION_PORT=8097
OPSAI_PREDICTOR_PORT=8098
EXTERNAL_AUTH_PORT=8099
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Local-only credentials. Do not commit .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
POSTGRES_DB=opsai
POSTGRES_USER=opsai
POSTGRES_PASSWORD=
AUTOMATION_API_TOKEN=
EXTERNAL_AUTH_INITIAL_TOKEN=

# Deterministic detection
DETECTOR_EVALUATION_SECONDS=5
LATENCY_OPEN_SECONDS=0.8
LATENCY_RECOVERY_SECONDS=0.45
LATENCY_OPEN_EVALUATIONS=3
LATENCY_CLOSE_EVALUATIONS=4
RETRY_OPEN_RATE=0.05
RETRY_RECOVERY_RATE=0.01
RETRY_OPEN_EVALUATIONS=2
RETRY_CLOSE_EVALUATIONS=4
FLAPPING_HOLD_DOWN_SECONDS=18

# Investigation provider. mock is deterministic and is not a real-AI demo.
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=45
AGENT_POLL_INTERVAL_SECONDS=5

# OpenAI - optional
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Azure OpenAI - optional. Deployment is the deployed model name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Governed automation
VIRTUAL_DISK_CAPACITY_BYTES=167772160
DISK_OPEN_PERCENT=85
DISK_RECOVERY_PERCENT=70
CERT_OPEN_SECONDS=900
AUTOMATION_MONITOR_SECONDS=3
DEMO_CERT_HOSTNAME=checkout.pulseguard.local
SLA_RISK_SECONDS=300
SUPPORT_HANDOFF_DELAY_SECONDS=180

# Predictive analysis
PREDICTOR_POLL_SECONDS=15
PREDICTOR_RANGE_WINDOW_SECONDS=900
PREDICTOR_RANGE_STEP_SECONDS=15
PREDICTOR_MIN_SAMPLES=12
PREDICTOR_RECURRENCE_LOOKBACK_HOURS=24
PREDICTOR_RECURRENCE_THRESHOLD=2
PREDICTOR_RECURRENCE_EVALUATION_SECONDS=60
PREDICTOR_DISK_HORIZON_SECONDS=1800
PREDICTOR_LATENCY_HORIZON_SECONDS=900
