  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active incidents",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(opsai_incident_active) or vector(0)",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Detector evaluation age",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "time() - opsai_detector_last_evaluation_timestamp_seconds",
          "legendFormat": "age",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Incidents opened",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(opsai_incidents_opened_total) or vector(0)",
          "legendFormat": "opened",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Incidents resolved",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(opsai_incidents_resolved_total) or vector(0)",
          "legendFormat": "resolved",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Payment node p95 latency vs detection threshold",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,node) (rate(opsai_router_node_duration_seconds_bucket[1m]))) * 1000",
          "legendFormat": "{{node}}",
          "refId": "A"
        },
        {
          "expr": "vector(800)",
          "legendFormat": "open threshold",
          "refId": "B"
        },
        {
          "expr": "vector(450)",
          "legendFormat": "recovery threshold",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retry rate by failed node vs timeout threshold",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(opsai_router_retries_total[1m])) by (failed_node)",
          "legendFormat": "{{failed_node}}",
          "refId": "A"
        },
        {
          "expr": "vector(0.05)",
          "legendFormat": "open threshold",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Detection conditions",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "opsai_detector_rule_condition",
          "legendFormat": "{{rule}} / {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Active incident signals",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "opsai_incident_active == 1",
          "legendFormat": "{{type}} / {{node}} / {{severity}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Checkout p95 and failure percentage",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(opsai_checkout_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "checkout p95 ms",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(opsai_checkout_requests_total{status=\"failed\"}[1m])) / clamp_min(sum(rate(opsai_checkout_requests_total[1m])),0.001)",
          "legendFormat": "failure percent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Incident lifecycle counters",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(opsai_incidents_opened_total[15m])) by (type,node)",
          "legendFormat": "opened {{type}} / {{node}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(opsai_incidents_resolved_total[15m])) by (type,node)",
          "legendFormat": "resolved {{type}} / {{node}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
